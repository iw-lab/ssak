rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is super admin
    function isSuperAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Helper function: Check if user is teacher
    function isTeacher() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Helper function: Check if user is student
    function isStudent() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    // Helper function: Check if user is approved teacher
    function isApprovedTeacher() {
      return isTeacher() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    // Helper function: Check if teacher owns the class that a student belongs to
    // Looks up the student classCode from users, then checks teacher owns that class
    function isTeacherOfStudent(studentId) {
      let studentData = get(/databases/$(database)/documents/users/$(studentId)).data;
      return studentData.classCode != null &&
             get(/databases/$(database)/documents/classes/$(studentData.classCode)).data.teacherId == request.auth.uid;
    }

    // 이 반의 담임인가(승인된 교사만) — 2026-11-18 개인정보 전수 점검: 교사는 «자기 반»만 본다
    function isApprovedTeacherOfClass(classCode) {
      return isApprovedTeacher() && classCode != null &&
             get(/databases/$(database)/documents/classes/$(classCode)).data.teacherId == request.auth.uid;
    }
    // 학생 본인이 속한 반인가
    function isStudentOfClass(classCode) {
      return classCode != null && isStudent() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classCode', null) == classCode;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own document, teachers/admins can read any
      // 본인 · 슈퍼관리자 · 그 학생의 담임만(승인 대기 교사·다른 학교 교사는 못 본다)
      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId || isSuperAdmin() ||
                      (resource.data.role == 'student' && isApprovedTeacherOfClass(resource.data.classCode)));

      // Users can create their own document during registration
      // OR approved teachers can create student accounts (batch creation)
      // Security: role must be 'student' or 'teacher' only (prevent privilege escalation)
      // 교사는 스스로 «승인됨»으로 가입할 수 없다(승인은 슈퍼관리자만) — 2026-11-18 전수 점검에서 뚫려 있었다
      allow create: if isAuthenticated() &&
                       ((request.auth.uid == userId &&
                         request.resource.data.uid == userId &&
                         // 학생 반 배정은 선생님(일괄 생성 함수)만 — 스스로 «B반 학생»이라 적고 명단을 읽지 못하게
                         ((request.resource.data.role == 'student' && request.resource.data.get('classCode', null) == null &&
                           request.resource.data.get('isTestStudent', false) == false) ||
                          (request.resource.data.role == 'teacher' && request.resource.data.get('approved', false) == false))) ||
                        (request.resource.data.role == 'student' &&
                         isApprovedTeacherOfClass(request.resource.data.get('classCode', null))));

      // Users can update their own document OR super admin can update any
      // OR approved teachers can update student classCode (for class operations)
      // Security: users cannot change their own role or approved status
      allow update: if isAuthenticated() &&
                       ((request.auth.uid == userId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved', 'isTestStudent', 'classCode'])) ||
                        isSuperAdmin() ||
                        (resource.data.role == 'student' &&
                         isApprovedTeacherOfClass(resource.data.classCode) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved', 'uid', 'email'])) &&
                         // 반을 옮길 땐 옮겨 갈 반도 내 반이어야(학생 계정을 남의 반에 심어 명단을 보는 길 차단) — 빼기(null)는 허용
                         (request.resource.data.get('classCode', null) == null ||
                          isApprovedTeacherOfClass(request.resource.data.get('classCode', null)))));

      // Only super admin can delete users
      allow delete: if isSuperAdmin();
    }

    // Classes collection
    match /classes/{classCode} {
      // 담임 · 그 반 학생 · 슈퍼관리자만(명단이 들어 있다). 없는 코드 확인(새 반 만들 때 중복 검사)은 교사에게 허용
      allow read: if isAuthenticated() &&
                     (isSuperAdmin() ||
                      (resource == null && isTeacher()) ||
                      (resource != null && resource.data.teacherId == request.auth.uid && isApprovedTeacher()) ||
                      isStudentOfClass(classCode));

      // Only approved teachers can create classes
      // 지운 반 코드는 다시 못 만든다(남은 옛 글·학생이 새 담임에게 보이는 길) — 함수가 retiredClassCodes 에 적는다
      allow create: if isApprovedTeacher() &&
                       !exists(/databases/$(database)/documents/retiredClassCodes/$(classCode)) &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.students.size() == 0 &&
                       request.resource.data.maxStudents == 40;

      // 담임·슈퍼관리자만. 랭킹은 서버 트리거(onWritingSubmitted)가 쓴다 — 예전엔 반 학생 누구나 랭킹을 직접 고칠 수 있었다(2026-11-20)
      allow update: if isAuthenticated() &&
                       ((resource.data.teacherId == request.auth.uid && isApprovedTeacher() &&
                         request.resource.data.teacherId == resource.data.teacherId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['weeklyRanking', 'monthlyRanking'])) ||
                        isSuperAdmin());

      // 반 삭제는 학생·글까지 함께 지우는 서버 함수(deleteClassWithStudents)로만 — 문서만 지우면 옛 글이 남는다
      allow delete: if isSuperAdmin();
    }

    // 지운 반 코드 목록 — 서버(관리자 SDK)만 쓴다
    match /retiredClassCodes/{code} {
      allow read, write: if false;
    }

    // Writings collection
    // 점수 서명: 점수가 없으면(임시 저장) 통과, 시험용 학생은 통과, 그 밖엔 analyses/{analysisId} 가 내 것이고 점수가 같아야
    function scoreIsSigned() {
      let d = request.resource.data;
      return !('score' in d) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isTestStudent', false) == true ||
             (d.get('analysisId', '') is string && d.get('analysisId', '') != '' &&
              exists(/databases/$(database)/documents/analyses/$(d.analysisId)) &&
              get(/databases/$(database)/documents/analyses/$(d.analysisId)).data.uid == request.auth.uid &&
              get(/databases/$(database)/documents/analyses/$(d.analysisId)).data.score == d.score &&
              d.get('content', '') is string &&
              get(/databases/$(database)/documents/analyses/$(d.analysisId)).data.get('len', -1) == d.get('content', '').size());
    }
    function noTeacherFields() {
      return !request.resource.data.keys().hasAny(['teacherComment', 'teacherScore', 'teacherCheckedAt', 'teacherName', 'reviewed', 'reviewedAt']);
    }
    function teacherFieldsValid() {
      let d = request.resource.data;
      return (!('teacherComment' in d) || d.teacherComment == null || (d.teacherComment is string && d.teacherComment.size() <= 500)) &&
             (!('teacherScore' in d) || d.teacherScore == null || (d.teacherScore is int && d.teacherScore >= 0 && d.teacherScore <= 100)) &&
             (!('teacherName' in d) || d.teacherName == null || (d.teacherName is string && d.teacherName.size() <= 20));
    }

    match /writings/{writingId} {
      // Students can read their own writings, super admins can read all
      // Approved teachers can read any writings (cross-doc get() breaks list queries)
      // Client-side code already filters by classCode for teacher's own class
      // 본인 · 슈퍼관리자 · 그 반 담임만(다른 학교 교사는 못 본다)
      allow read: if isAuthenticated() &&
                     (resource.data.studentId == request.auth.uid ||
                      isSuperAdmin() ||
                      isApprovedTeacherOfClass(resource.data.classCode));

      // Only students can create writings (for themselves)
      // 자기 반 코드로만 쓴다(남의 반 담임 목록에 끼워 넣기 금지)
      // 점수는 서버가 서명한 첨삭(analyses/{analysisId})과 같아야 한다(2026-11-20 — 예전엔 브라우저가 아무 점수나 썼다)
      allow create: if isStudent() &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.get('classCode', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classCode', null) &&
                       scoreIsSigned() && noTeacherFields();

      // 학생: 자기 글(점수는 서명된 것만, 선생님 칸은 못 건드림) / 담임: 확인·한마디·점수 고치기 칸만
      allow update: if (isStudent() && resource.data.studentId == request.auth.uid &&
                        request.resource.data.studentId == resource.data.studentId &&
                        request.resource.data.get('classCode', null) == resource.data.get('classCode', null) &&
                        // 점수·글이 그대로면 통과, 하나라도 바뀌면 서명이 새 글과 맞아야(점수는 두고 글만 바꿔치기 금지)
                        ((request.resource.data.get('score', null) == resource.data.get('score', null) &&
                          request.resource.data.get('content', null) == resource.data.get('content', null)) || scoreIsSigned()) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherComment', 'teacherScore', 'teacherCheckedAt', 'teacherName', 'reviewed', 'reviewedAt'])) ||
                       (isApprovedTeacherOfClass(resource.data.classCode) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed', 'reviewedAt', 'teacherComment', 'teacherScore', 'teacherCheckedAt', 'teacherName']) &&
                        teacherFieldsValid());

      // Student can delete their own writing
      // Teacher can only delete writings from their own class (cross-class restriction)
      // Super admin can delete any
      allow delete: if isAuthenticated() &&
                       (resource.data.studentId == request.auth.uid ||
                        isSuperAdmin() ||
                        isApprovedTeacherOfClass(resource.data.get('classCode', null)));
    }

    // Student stats collection
    match /studentStats/{studentId} {
      // Students can only read their own stats
      // Teachers can only read stats of students in their own class (cross-class restriction)
      // Super admins can read all
      allow read: if isAuthenticated() &&
                     (request.auth.uid == studentId ||
                      isSuperAdmin() ||
                      (isApprovedTeacher() && isTeacherOfStudent(studentId)));

      // Only the student themselves or system can write stats
      allow write: if isAuthenticated() &&
                      (request.auth.uid == studentId ||
                       isSuperAdmin());
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      // 과제 문서엔 제출 명단(별명·점수)이 있다 — 그 반 담임·그 반 학생·슈퍼관리자만(2026-11-18 전수 점검)
      allow read: if isAuthenticated() &&
                     (isSuperAdmin() ||
                      isApprovedTeacherOfClass(resource.data.classCode) ||
                      isStudentOfClass(resource.data.classCode));

      // 자기 반에, 자기 이름으로만 낸다
      allow create: if request.resource.data.teacherId == request.auth.uid &&
                       isApprovedTeacherOfClass(request.resource.data.classCode);

      // Teacher/super admin can update anything
      // Students can only update submissions field (for adding their submission info)
      allow update: if isAuthenticated() &&
                       ((resource.data.teacherId == request.auth.uid && isApprovedTeacher() &&
                         request.resource.data.teacherId == resource.data.teacherId &&
                         request.resource.data.classCode == resource.data.classCode) ||
                        isSuperAdmin() ||
                        (isStudentOfClass(resource.data.classCode) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissions']) &&
                         request.resource.data.submissions.size() >= resource.data.get('submissions', []).size() - 1));

      // Only teacher or super admin can delete
      allow delete: if isAuthenticated() &&
                       (resource.data.teacherId == request.auth.uid ||
                        isSuperAdmin());
    }

    // Assignment submissions collection
    match /submissions/{submissionId} {
      // Students can read their own submissions
      // Teachers can only read submissions from students in their class (cross-class restriction)
      // Super admins can read all
      allow read: if isAuthenticated() &&
                     (resource.data.studentId == request.auth.uid ||
                      isSuperAdmin() ||
                      (isApprovedTeacher() && isTeacherOfStudent(resource.data.studentId)));

      // Only students can create submissions (for themselves)
      allow create: if isStudent() &&
                       request.resource.data.studentId == request.auth.uid;

      // Only the student who submitted, their class teacher, or super admin can update
      allow update: if isAuthenticated() &&
                       request.resource.data.studentId == resource.data.studentId &&
                       (resource.data.studentId == request.auth.uid ||
                        isSuperAdmin() ||
                        (isApprovedTeacher() && isTeacherOfStudent(resource.data.studentId)));

      // Only the student who submitted, their class teacher, or super admin can delete
      allow delete: if isAuthenticated() &&
                       (resource.data.studentId == request.auth.uid ||
                        isSuperAdmin() ||
                        (isApprovedTeacher() && isTeacherOfStudent(resource.data.studentId)));
    }

    // Scheduler settings collection
    match /schedulers/{classCode} {
      // Teachers and super admin can read scheduler settings
      allow read, write: if isSuperAdmin() || isApprovedTeacherOfClass(classCode);
    }

    // Auto assignment logs collection
    match /autoAssignmentLogs/{logId} {
      // Teachers and super admin can read auto assignment logs
      // 문서 id 는 자동 id — 반은 classCode 칸으로 본다(옛 규칙은 classes/$(logId)를 찾아 늘 거부됐다)
      allow read: if isSuperAdmin() || isApprovedTeacherOfClass(resource.data.classCode);
      allow create: if isSuperAdmin() || isApprovedTeacherOfClass(request.resource.data.classCode);
      allow update, delete: if isSuperAdmin() || isApprovedTeacherOfClass(resource.data.classCode);
    }

    // Drafts collection (임시 저장)
    match /drafts/{draftId} {
      // Students can read/write their own drafts
      // draftId format: draft_{studentId}_{topic}
      allow read, write: if isAuthenticated() &&
                            draftId.matches('draft_' + request.auth.uid + '_.*');
    }

    // ===== 싹DB 컬렉션들 (읽기 전용, 관리자만 쓰기 가능) =====

    // 평가 루브릭
    match /rubrics/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 우수작 예시
    match /examples/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 첨삭 패턴
    match /feedbackPatterns/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 글쓰기 이론
    match /writingTheory/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // AI 판별
    match /aiDetection/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 주제 뱅크
    match /topics/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 학습 경로
    match /learningPaths/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 평가 도구
    match /evaluationTools/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 시스템 설정
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 메타데이터
    match /metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 기타
    match /misc/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 싹DB 메타 정보
    match /ssakdb_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 첨삭 서명·같은 글 기록 — 함수만 다룬다(학생이 점수를 위조하거나 남의 첨삭을 읽지 못하게)
    match /analyses/{docId} {
      allow read, write: if false;
    }
    match /analysisCache/{docId} {
      allow read, write: if false;
    }

    // 자기번호 해시·틀린 횟수 — 함수(pinLogin·issueStudentPins)만 다룬다. 관리자도 못 읽는다
    match /pinAuth/{docId} {
      allow read, write: if false;
    }

    // 가림용 반 명단(반 아이 이름) — 함수(setMaskNames·getMaskNames·가림)만 다룬다. 학생·다른 교사·관리자 화면 모두 직접 못 읽는다
    match /classMaskNames/{classCode} {
      allow read, write: if false;
    }

    // 3-2 친구 글 칭찬·질문 — 가린 사본·남긴 말 모두 함수(peerShare·peerSend·peerDecide…)만 다룬다(글쓴이·보낸이 칸 보호)
    match /peerShares/{docId} {
      allow read, write: if false;
    }
    match /peerNotes/{docId} {
      allow read, write: if false;
    }

    // 3-4 실시간 교실 현황 — 학생은 «주제·글자 수·시각»만 자기 칸에 쓴다(글 내용 없음). 읽기는 그 반 담임만
    match /presence/{uid} {
      allow read: if isAuthenticated() && (isApprovedTeacherOfClass(resource.data.classCode) || isSuperAdmin());
      allow create, update: if isStudent() && uid == request.auth.uid &&
                               request.resource.data.keys().hasOnly(['classCode', 'topic', 'len', 'at', 'state']) &&
                               request.resource.data.classCode is string &&
                               request.resource.data.classCode == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classCode', null) &&
                               // 같은 주제·상태로는 1분에 한 번만(브라우저 쓰로틀을 건너뛴 연타 막기)
                               (resource == null || request.resource.data.topic != resource.data.topic || request.resource.data.state != resource.data.state ||
                                request.time > resource.data.at + duration.value(60, 's')) &&
                               request.resource.data.topic is string && request.resource.data.topic.size() <= 200 &&
                               request.resource.data.len is int && request.resource.data.len >= 0 && request.resource.data.len <= 20000 &&
                               request.resource.data.at == request.time &&
                               request.resource.data.state in ['writing', 'submitted', 'left'];
      allow delete: if false;
    }

    // API 사용량 추적 (Cloud Functions에서 기록, 관리자만 읽기)
    match /usage/{docId} {
      allow read: if isSuperAdmin(); // 사용자별 사용량 — 관리자만(앱은 함수 getUsageStats 로 본다)
      allow write: if isSuperAdmin();
    }

    // API 비용 추적
    match /apiCosts/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 가정통신문 컬렉션
    match /newsletters/{docId} {
      allow read: if isSuperAdmin() || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isApprovedTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSuperAdmin() ||
                       (resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isSuperAdmin() || resource.data.teacherId == request.auth.uid;
    }
  }
}
